/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	binman {
		rockchip-maskrom-loader {
			rockchip,chip = "rk3576";

			spl {
				type = "section";
				rockchip,entry-type = "472";
				rockchip,entry-name = "a-very-long-entry-name";

				u-boot-spl {
				};
			};
		};
	};
};
